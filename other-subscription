import pandas as pd
import matplotlib.pyplot as plt

data = [
    {"quarter": "Q2'23", "revenue": 46, "percent": 14},
    {"quarter": "Q3'23", "revenue": 48, "percent": 17},
    {"quarter": "Q4'23", "revenue": 66, "percent": 13},
    {"quarter": "Q1'24", "revenue": 96, "percent": 9},
    {"quarter": "Q2'24", "revenue": 104, "percent": 13},
    {"quarter": "Q3'24", "revenue": 90, "percent": 16},
    {"quarter": "Q4'24", "revenue": 135, "percent": 12},
    {"quarter": "Q1'25", "revenue": 111, "percent": 11},
    {"quarter": "Q2'25", "revenue": 119, "percent": 17},
    {"quarter": "Q3'25", "revenue": 138, "percent": 17},
]

df = pd.DataFrame(data)

# Create figure and axes
fig, ax1 = plt.subplots(figsize=(12, 6))

# Bar plot
bars = ax1.bar(df["quarter"], df["revenue"], color="#8C6AD9", alpha=0.9, label="Other Subscription and Services Revenue ($M)")
ax1.set_ylabel("Other Subscription and Services Revenue ($M)", color="black", fontsize=11, fontweight="bold")
ax1.set_ylim(0, 140)

# Add bar value labels centered inside bars
for bar in bars:
    height = bar.get_height()
    ax1.text(
        bar.get_x() + bar.get_width() / 2,
        height / 2,
        f"{int(height)}",
        ha="center",
        va="center",
        color="white",
        fontsize=9,
        fontweight="bold"
    )

# Secondary y-axis
ax2 = ax1.twinx()
ax2.plot(df["quarter"], df["percent"], color="black", marker="o", linewidth=2, label="Proportion of Trading Revenue (%)")
ax2.set_ylabel("Proportion of Trading Revenue (%)", color="black", fontsize=11, fontweight="bold")
ax2.set_ylim(0, 20)

# Annotate line points
for i, val in enumerate(df["percent"]):
    ax2.text(i, val + 0.5, f"{val}%", ha="center", va="bottom", color="black", fontsize=9, fontweight="bold")

# Title and legend
plt.title("Other Subscription and Service Revenue ($M)", fontsize=13, fontweight="bold")
ax1.legend(loc="upper left", frameon=True)
ax2.legend(loc="upper right", frameon=True)

ax1.grid(axis="y", linestyle="--", alpha=0.6)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
