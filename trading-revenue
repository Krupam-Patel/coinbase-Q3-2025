import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

data = {
    'Quarter': ['Q2’23','Q3’23','Q4’23','Q1’24','Q2’24','Q3’24','Q4’24','Q1’25','Q2’25','Q3’25'],
    'Retail': [310, 275, 493, 935, 665, 483, 1347, 1096, 650, 734],
    'Institutional': [17, 14, 37, 64, 64, 55, 141, 99, 61, 77],
    'TakeRate': [2.20, 2.60, 1.90, 1.80, 1.42, 1.43, 1.40, 1.40, 1.51, 1.55]
}

df = pd.DataFrame(data)

# Graph Setup 
fig, ax1 = plt.subplots(figsize=(11, 5.5))

# Bar plot for revenues
bar_width = 0.6
x = np.arange(len(df))
ax1.bar(x, df['Retail'], width=bar_width, color='lightgray', label='Retail', zorder=2)
ax1.bar(x, df['Institutional'], width=bar_width, bottom=df['Retail'], color='mediumpurple', alpha=0.7, label='Institutional', zorder=3)

# Annotate bar values
for i, row in df.iterrows():
    ax1.text(i, row['Retail']/2, f"{int(row['Retail'])}", ha='center', va='center', fontsize=10, color='black')
    ax1.text(i, row['Retail'] + row['Institutional']/2, f"{int(row['Institutional'])}", ha='center', va='center', fontsize=10, color='black')

# Axis labels and formatting
ax1.set_xlabel('')
ax1.set_ylabel('Revenue ($M)', fontsize=11)
ax1.set_xticks(x)
ax1.set_xticklabels(df['Quarter'], fontsize=10)
ax1.tick_params(axis='y', labelsize=10)
ax1.set_ylim(0, 1500)
ax1.grid(True, linestyle='--', alpha=0.6, zorder=1)

# Line plot for Take Rate
ax2 = ax1.twinx()
ax2.plot(x, df['TakeRate'], color='black', marker='o', linewidth=1.5, markersize=5, zorder=4)
ax2.set_ylabel('Take Rate (%)', fontsize=11)
ax2.set_ylim(0, 3.0)
ax2.tick_params(axis='y', labelsize=10)

# Annotate Take Rate values
for i, row in df.iterrows():
    ax2.annotate(f"{row['TakeRate']:.2f}%", (i, row['TakeRate']),
                 textcoords="offset points", xytext=(0,5), ha='center', fontsize=10, color='black')

# Finishing touches
ax1.set_title('Coinbase Trading Revenue ($M)', fontsize=14, weight='medium', pad=10)
ax1.legend(frameon=True, loc='upper left', fontsize=10)
plt.tight_layout()
plt.show()
