import pandas as pd
import matplotlib.pyplot as plt

data = [
    {'quarter':'Q2-23', 'vol_retail':? , 'rev_retail':310, 'vol_inst':? , 'rev_inst':17},
    {'quarter':'Q3-23', 'vol_retail':? , 'rev_retail':275, 'vol_inst':? , 'rev_inst':14},
    {'quarter':'Q4-23', 'vol_retail':? , 'rev_retail':493, 'vol_inst':? , 'rev_inst':37},
    {'quarter':'Q1-24', 'vol_retail':? , 'rev_retail':935, 'vol_inst':? , 'rev_inst':64},
    {'quarter':'Q2-24', 'vol_retail':? , 'rev_retail':665, 'vol_inst':? , 'rev_inst':55},
    {'quarter':'Q3-24', 'vol_retail':? , 'rev_retail':483, 'vol_inst':? , 'rev_inst':141},
    {'quarter':'Q4-24', 'vol_retail':? , 'rev_retail':1347, 'vol_inst':? , 'rev_inst':141},
    {'quarter':'Q1-25', 'vol_retail':? , 'rev_retail':1096, 'vol_inst':? , 'rev_inst':99},
    {'quarter':'Q2-25', 'vol_retail':? , 'rev_retail':650, 'vol_inst':? , 'rev_inst':61},
    {'quarter':'Q3-25', 'vol_retail':? , 'rev_retail':700, 'vol_inst':? , 'rev_inst':74},
]

df = pd.DataFrame(data)

# Computing rates 
df['take_retail_pct'] = df['rev_retail'] / df['vol_retail'] * 100
df['take_inst_pct']   = df['rev_inst']   / df['vol_inst']   * 100

# Plotting
fig, ax1 = plt.subplots(figsize=(10,6))

# Stacked bars for revenues
ax1.bar(df['quarter'], df['rev_retail'], label='Retail Revenue', color='lightgrey')
ax1.bar(df['quarter'], df['rev_inst'], bottom=df['rev_retail'], label='Institutional Revenue', color='mediumpurple')
ax1.set_ylabel('Revenue (US$ M)')

# Line graph 
ax2 = ax1.twinx()
ax2.plot(df['quarter'], df['take_retail_pct'], marker='o', color='violet', label='Retail Take Rate')
ax2.plot(df['quarter'], df['take_inst_pct'],   marker='o', color='black', label='Institutional Take Rate')
ax2.set_ylabel('Take Rate (%)')

# Annotations for take-rates
for i, row in df.iterrows():
    ax2.annotate(f"{row['take_retail_pct']:.2f}%",  (i, row['take_retail_pct']), textcoords="offset points", xytext=(0,5), ha='center', color='violet')
    ax2.annotate(f"{row['take_inst_pct']:.2f}%",    (i, row['take_inst_pct']),   textcoords="offset points", xytext=(0,-10), ha='center', color='black')

ax1.set_title('Coinbase Trading Revenue ($M)')
ax1.legend(loc='upper left')
ax2.legend(loc='upper right')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
