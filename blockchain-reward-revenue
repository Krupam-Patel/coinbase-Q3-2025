import pandas as pd
import matplotlib.pyplot as plt

data = [
    {'quarter':"Q2'23", 'staked_eth':3197, 'reward_rev':88},
    {'quarter':"Q3'23", 'staked_eth':3940, 'reward_rev':75},
    {'quarter':"Q4'23", 'staked_eth':4344, 'reward_rev':95},
    {'quarter':"Q1'24", 'staked_eth':4502, 'reward_rev':151},
    {'quarter':"Q2'24", 'staked_eth':4386, 'reward_rev':185},
    {'quarter':"Q3'24", 'staked_eth':4198, 'reward_rev':155},
    {'quarter':"Q4'24", 'staked_eth':3734, 'reward_rev':215},
    {'quarter':"Q1'25", 'staked_eth':2935, 'reward_rev':197},
    {'quarter':"Q2'25", 'staked_eth':2652, 'reward_rev':145},
    {'quarter':"Q3'25", 'staked_eth':2518, 'reward_rev':189},
]

df = pd.DataFrame(data)

# Plotting
fig, ax1 = plt.subplots(figsize=(12,6))

# Labeling axis
ax1.set_ylabel('Staked ETH (K)')
ax1.set_ylim(0, 5000)
ax2 = ax1.twinx()
ax2.set_ylabel('Blockchain Reward Revenue ($M)')
ax2.set_ylim(50, 250)

# Bar chart for Staked ETH
bars = ax1.bar(df['quarter'], df['staked_eth'], color='#9470D1', label='Staked ETH (K)')

# Annotate bar values
for bar in bars:
    height = bar.get_height()
    ax1.text(
        bar.get_x() + bar.get_width()/2, height/2, f"{int(height)}",
        ha='center', va='center', color='white', fontweight='bold', fontsize=10
    )

# Line graph for Reward Revenue
ax2.plot(df['quarter'], df['reward_rev'], marker='o', color='black', linewidth=2,
         label='Blockchain Reward Revenue ($M)')

# Annotate line values
for i, row in df.iterrows():
    ax2.text(i, row['reward_rev'] + 5, f"{row['reward_rev']}", 
             ha='center', va='bottom', color='black', fontweight='bold')

handles1, labels1 = ax1.get_legend_handles_labels()
handles2, labels2 = ax2.get_legend_handles_labels()
ax1.legend(handles1 + handles2, labels1 + labels2, loc='upper left')
plt.title('Blockchain Rewards Revenue & Staked ETH ($M)')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
