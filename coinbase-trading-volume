import pandas as pd
import matplotlib.pyplot as plt

data = [
    {'quarter':'Q2 23', 'institutional':78,  'retail':14},
    {'quarter':'Q3 23', 'institutional':65,  'retail':11},
    {'quarter':'Q4 23', 'institutional':125, 'retail':29},
    {'quarter':'Q1 24', 'institutional':256, 'retail':56},
    {'quarter':'Q2 24', 'institutional':189, 'retail':37},
    {'quarter':'Q3 24', 'institutional':151, 'retail':34},
    {'quarter':'Q4 24', 'institutional':345, 'retail':94},
    {'quarter':'Q1 25', 'institutional':315, 'retail':78},
    {'quarter':'Q2 25', 'institutional':194, 'retail':43},
    {'quarter':'Q3 25', 'institutional':248, 'retail':62},
]

df = pd.DataFrame(data)

# Calculating totals and retail %
df['total'] = df['institutional'] + df['retail']
df['retail_pct'] = df['retail'] / df['total'] * 100

# Graph setup
fig, ax1 = plt.subplots(figsize=(14, 9))
ax2 = ax1.twinx()

# Axis labels
ax1.set_ylabel('Volume (US$ billion)', fontsize=13)
ax2.set_ylabel('Retail %', fontsize=13)

# Bars for Institutional and Retail
ax1.bar(df['quarter'], df['institutional'], label='Institutional', color='mediumpurple')
ax1.bar(df['quarter'], df['retail'], bottom=df['institutional'], label='Retail', color='lightgray')

# Line for Retail %
ax2.plot(df['quarter'], df['retail_pct'], marker='o', color='black', linewidth=2.5, label='Retail %')

# Annotations for Retail % line
for i, val in enumerate(df['retail_pct']):
    ax2.text(i, val - 0.15, f"{val:.0f}%", ha='center', va='top', fontsize=12, fontweight='bold')

# Label bar values
for i in range(len(df)):
    inst_val = df.loc[i, 'institutional']
    ret_val = df.loc[i, 'retail']

    # Institutional label (inside purple section)
    ax1.text(i, inst_val / 2, f"{inst_val}", ha='center', va='center', color='white', fontsize=11, fontweight='bold')

    # Retail label (inside gray section)
    ax1.text(i, inst_val + ret_val / 2 + 3, f"{ret_val}", ha='center', va='center', color='black', fontsize=11, fontweight='bold')

# Finishing touches
ax1.set_title('Coinbase Trading Volume (US$ Billion)', fontsize=18, fontweight='bold', pad=20)
ax1.legend(loc='upper left', fontsize=11)
ax2.legend(loc='upper right', fontsize=11)
plt.xticks(rotation=45, fontsize=12)
ax1.tick_params(axis='y', labelsize=11)
ax2.tick_params(axis='y', labelsize=11)
plt.tight_layout()
plt.show()
