import pandas as pd
import matplotlib.pyplot as plt

# Updated data
data = [
    {"quarter": "Q2'23", "marketcap": 32.55, "treasury_rate": 4.72},
    {"quarter": "Q3'23", "marketcap": 27.37, "treasury_rate": 5.11},
    {"quarter": "Q4'23", "marketcap": 25.11, "treasury_rate": 4.96},
    {"quarter": "Q1'24", "marketcap": 24.49, "treasury_rate": 4.67},
    {"quarter": "Q2'24", "marketcap": 32.39, "treasury_rate": 4.89},
    {"quarter": "Q3'24", "marketcap": 32.26, "treasury_rate": 4.28},
    {"quarter": "Q4'24", "marketcap": 35.60, "treasury_rate": 4.07},
    {"quarter": "Q1'25", "marketcap": 43.95, "treasury_rate": 3.97},
    {"quarter": "Q2'25", "marketcap": 60.08, "treasury_rate": 4.04},
    {"quarter": "Q3'25", "marketcap": 61.00, "treasury_rate": 3.88},  # Updated to match paragraph
]

df = pd.DataFrame(data)

# Plot setup
fig, ax1 = plt.subplots(figsize=(12, 6))

# Primary y-axis (USDC Market Cap)
bars = ax1.bar(df['quarter'], df['marketcap'], color='#9470D1', alpha=0.9, label='USDC Market Cap ($B)')
ax1.set_ylabel('USDC Market Cap ($B)', color='black', fontsize=11, fontweight='bold')
ax1.set_ylim(0, 70)  # Adjusted to fit updated values

# Annotate bar values
for bar in bars:
    height = bar.get_height()
    ax1.text(
        bar.get_x() + bar.get_width() / 2,
        height / 2,
        f"{height:.2f}",
        ha='center', va='center',
        color='white', fontweight='bold', fontsize=9
    )

# Secondary y-axis (52-Week Treasury Rate)
ax2 = ax1.twinx()
ax2.plot(df['quarter'], df['treasury_rate'], color='black', marker='o', linewidth=2, label='52-Week Treasury Rate (%)')
ax2.set_ylabel('52-Week Treasury Rate (%)', color='black', fontsize=11, fontweight='bold')
ax2.set_ylim(0, 6)

# Annotate line values
for i, val in enumerate(df['treasury_rate']):
    ax2.text(i, val + 0.1, f"{val:.2f}%", ha='center', va='bottom', fontsize=9, color='black', fontweight='bold')

# Legend and labels
handles1, labels1 = ax1.get_legend_handles_labels()
handles2, labels2 = ax2.get_legend_handles_labels()
ax1.legend(handles1 + handles2, labels1 + labels2, loc='upper left', frameon=True)

# Title and grid
plt.title("USDC Market Capitalization and 52-Week Treasury Rate", fontsize=13, fontweight='bold')
ax1.grid(axis='y', linestyle='--', alpha=0.6)
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
