import pandas as pd
import matplotlib.pyplot as plt

# Data based on the chart you uploaded
data = [
    {'quarter': 'Q2\'23', 'usdc_marketcap': 32.55, 'treasury_rate': 4.72},
    {'quarter': 'Q3\'23', 'usdc_marketcap': 27.37, 'treasury_rate': 5.11},
    {'quarter': 'Q4\'23', 'usdc_marketcap': 25.11, 'treasury_rate': 4.96},
    {'quarter': 'Q1\'24', 'usdc_marketcap': 24.49, 'treasury_rate': 4.67},
    {'quarter': 'Q2\'24', 'usdc_marketcap': 32.39, 'treasury_rate': 4.89},
    {'quarter': 'Q3\'24', 'usdc_marketcap': 32.26, 'treasury_rate': 4.28},
    {'quarter': 'Q4\'24', 'usdc_marketcap': 35.60, 'treasury_rate': 4.07},
    {'quarter': 'Q1\'25', 'usdc_marketcap': 43.95, 'treasury_rate': 3.97},
    {'quarter': 'Q2\'25', 'usdc_marketcap': 60.08, 'treasury_rate': 4.04},
    {'quarter': 'Q3\'25', 'usdc_marketcap': 67.92, 'treasury_rate': 3.88},
]

df = pd.DataFrame(data)

# Plotting
fig, ax1 = plt.subplots(figsize=(10,6))

# Axis label
ax1.set_ylabel('USDC Market Cap ($B)')
ax1.tick_params(axis='y', labelcolor='black')
ax2 = ax1.twinx()
ax2.set_ylabel('52-Week Treasury Rate (%)', color='black')
ax2.tick_params(axis='y', labelcolor='black')

# Bar chart
ax1.bar(df['quarter'], df['usdc_marketcap'], color='mediumslateblue', alpha=0.5, label='USDC Market Cap ($B)')

# Annotate market cap values
for i, val in enumerate(df['usdc_marketcap']):
    ax1.text(i, val + 0.8, f"{val:.2f}", ha='center', va='bottom', fontsize=9, color='black')

# Line graph
ax2.plot(df['quarter'], df['treasury_rate'], color='black', marker='o', linewidth=2, label='52-Week Treasury Rate (%)')

# Annotate treasury rate values
for i, val in enumerate(df['treasury_rate']):
    ax2.text(i, val + 0.1, f"{val:.2f}%", ha='center', va='bottom', fontsize=9)

ax1.set_title('Stablecoin Marketcap & 52-Week Treasury Rate ($B)', fontsize=14, fontweight='bold')
ax1.legend(loc='upper left')
ax2.legend(loc='upper right')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
